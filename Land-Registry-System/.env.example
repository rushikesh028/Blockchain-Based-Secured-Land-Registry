MYSQL_DATABASE=landregistry
MYSQL_USER=landregistry
MYSQL_PASSWORD=replace-with-strong-app-db-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-db-password

APP_JWT_SECRET=replace-with-a-long-random-256-bit-secret
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# Optional one-time bootstrap admin account for the first deployment.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_FULL_NAME=Platform Administrator
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
